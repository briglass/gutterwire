# Copy to .env.local for development. Never commit real values.

# Shared password for the editor accounts (briglass, sixtas, bpaulsen).
ADMIN_PASSWORD=

# Long random string used to sign login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set automatically by Vercel when you attach a Postgres (Neon) database.
# Leave unset locally to use the built-in in-memory dev store.
# POSTGRES_URL=
