# Copy to .env.local for development. Never commit real values.

# Shared password for the editor accounts (briglass, sixtas, bpaulsen).
ADMIN_PASSWORD=

# Long random string used to sign login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set automatically by Vercel when you attach a Postgres (Neon) database.
# Leave unset locally to use the built-in in-memory dev store.
# DATABASE_URL=

# Anthropic API key for the wirebot (AI ingestion). Get one at
# https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=

# Shared secret so only Vercel Cron can trigger /api/ingest unattended.
# Any long random string; Vercel sends it as "Authorization: Bearer <value>".
CRON_SECRET=
